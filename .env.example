# ==============================================================================
# VYOM Environment Configuration
# All variables required for local development and production deployments.
# ==============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB single-node replica set connection string (rs0 required for transactions)
MONGODB_URI=mongodb://localhost:27017/vyom?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=vyom

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_USERNAME=VyomDemoShopBot
# Mode: "polling" for local dev, "webhook" for production
BOT_MODE=polling

# ── Sarvam AI (https://docs.sarvam.ai) ─────────────────────────────────────────
# Auth header: api-subscription-key
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# LLM: sarvam-105b via POST /v1/chat/completions (OpenAI-compatible)
# Note: sarvam-m and sarvam-30b are DEPRECATED and rejected by API
SARVAM_LLM_MODEL=sarvam-105b
# STT: saaras:v4 is latest/recommended
SARVAM_STT_MODEL=saaras:v4
# TTS: bulbul:v3 via POST /text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DOC_AI_ENABLED=true
# WebSocket streaming STT (saaras:v4)
STT_REALTIME=false

# ── Google Cloud Translation API ──────────────────────────────────────────────
# Used for server-side UI translation with in-memory / mongo cache
GOOGLE_TRANSLATE_API_KEY=

# ── Web / URLs / CORS ─────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Mode Switches ─────────────────────────────────────────────────────────────
# AI Mode: "mock" (runs demo without API keys) or "live" (calls Sarvam/Google)
AI_MODE=mock
DEMO_MODE=true
# Deterministic demo date in YYYY-MM-DD format (overrides system time for festival logic)
DEMO_TODAY=2026-09-30

# ── Timezone ──────────────────────────────────────────────────────────────────
# All dates, business hours, and festival phases strictly computed in IST
APP_TIMEZONE=Asia/Kolkata
